<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BitKraken.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="BitKraken.Views.AddTorrentDialog"
        x:DataType="vm:AddTorrentViewModel"
        Title="Add torrent"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Panel Margin="16">
    <Border CornerRadius="18" BoxShadow="0 20 60 0 #99000000, 0 0 0 1 #1AFFFFFF" />
    <Border CornerRadius="18" Background="{StaticResource Kraken.GlassStrong}"
            BorderBrush="{StaticResource Kraken.BorderStrongBrush}" BorderThickness="1">
        <StackPanel Spacing="16" Margin="24,18,24,22">

            <!-- Header / drag region -->
            <Grid ColumnDefinitions="Auto,*,Auto" chrome:WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent">
                <Panel Grid.Column="0" Width="34" Height="34" Margin="0,0,12,0">
                    <Border CornerRadius="10" Background="{StaticResource Kraken.AccentGradient}" BoxShadow="0 0 20 0 #808B5CF6" />
                    <PathIcon Data="{StaticResource Icon.Magnet}" Width="18" Height="18" Foreground="White" />
                </Panel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Add torrent" Classes="h2" />
                    <TextBlock Text="Paste a magnet link or choose a .torrent file" Classes="muted" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost icon" Width="30" Height="30" Padding="6" Command="{Binding CancelCommand}">
                    <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                </Button>
            </Grid>

            <!-- Source -->
            <StackPanel Spacing="6">
                <TextBlock Text="MAGNET LINK OR FILE" Classes="label" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" Name="SourceBox" Text="{Binding Source}" PlaceholderText="magnet:?xt=urn:btih:…" />
                    <Button Grid.Column="1" Classes="ghost icon" Margin="6,0,0,0" Command="{Binding PasteFromClipboardCommand}" ToolTip.Tip="Paste from clipboard">
                        <PathIcon Data="{StaticResource Icon.Clipboard}" Width="16" Height="16" />
                    </Button>
                    <Button Grid.Column="2" Classes="ghost icon" Margin="2,0,0,0" Command="{Binding BrowseFileCommand}" ToolTip.Tip="Browse for a .torrent file">
                        <PathIcon Data="{StaticResource Icon.Folder}" Width="16" Height="16" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource Kraken.AmberBrush}" FontSize="12"
                           IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Preview -->
            <Border IsVisible="{Binding HasPreview}" Background="{StaticResource Kraken.VioletBrush10}" CornerRadius="12" Padding="14,12"
                    BorderBrush="{StaticResource Kraken.VioletBrush40}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <PathIcon Grid.RowSpan="3" Data="{StaticResource Icon.File}" Width="28" Height="28" Foreground="{StaticResource Kraken.VioletLightBrush}" Margin="0,0,14,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding PreviewName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Classes="secondary" FontSize="12">
                        <Run Text="{Binding PreviewSize}" /><Run Text="  ·  " /><Run Text="{Binding PreviewFiles}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding PreviewHash}" Classes="muted mono" FontSize="11" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Save location -->
            <StackPanel Spacing="6">
                <TextBlock Text="SAVE TO" Classes="label" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding SaveDirectory}" />
                    <Button Grid.Column="1" Classes="ghost icon" Margin="6,0,0,0" Command="{Binding BrowseFolderCommand}" ToolTip.Tip="Choose folder">
                        <PathIcon Data="{StaticResource Icon.Folder}" Width="16" Height="16" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Footer -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                <ToggleSwitch Grid.Column="0" IsChecked="{Binding StartImmediately}" OnContent="Start immediately" OffContent="Add paused" FontSize="13" />
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Classes="primary" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanAdd}" IsDefault="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Add}" Width="14" Height="14" Foreground="White" />
                        <TextBlock Text="Add torrent" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
    </Panel>
</Window>
