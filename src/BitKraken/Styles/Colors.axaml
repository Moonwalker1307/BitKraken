<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Core palette: deep space purple ===== -->
    <Color x:Key="Kraken.Bg0">#0A0712</Color>
    <Color x:Key="Kraken.Bg1">#100C1B</Color>
    <Color x:Key="Kraken.Bg2">#171226</Color>
    <Color x:Key="Kraken.Bg3">#1F1833</Color>
    <Color x:Key="Kraken.Bg4">#2A2145</Color>
    <Color x:Key="Kraken.Border">#2C2347</Color>
    <Color x:Key="Kraken.BorderStrong">#3D3160</Color>

    <Color x:Key="Kraken.Violet">#8B5CF6</Color>
    <Color x:Key="Kraken.VioletLight">#A78BFA</Color>
    <Color x:Key="Kraken.VioletDark">#6D3FE0</Color>
    <Color x:Key="Kraken.Magenta">#D946EF</Color>
    <Color x:Key="Kraken.Pink">#EC4899</Color>
    <Color x:Key="Kraken.Cyan">#22D3EE</Color>
    <Color x:Key="Kraken.Green">#34D399</Color>
    <Color x:Key="Kraken.Amber">#FBBF24</Color>
    <Color x:Key="Kraken.Red">#F87171</Color>

    <Color x:Key="Kraken.Text">#F1ECFF</Color>
    <Color x:Key="Kraken.TextSecondary">#B4A9D6</Color>
    <Color x:Key="Kraken.TextMuted">#7C7199</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="Kraken.Bg0Brush" Color="{StaticResource Kraken.Bg0}" />
    <SolidColorBrush x:Key="Kraken.Bg1Brush" Color="{StaticResource Kraken.Bg1}" />
    <SolidColorBrush x:Key="Kraken.Bg2Brush" Color="{StaticResource Kraken.Bg2}" />
    <SolidColorBrush x:Key="Kraken.Bg3Brush" Color="{StaticResource Kraken.Bg3}" />
    <SolidColorBrush x:Key="Kraken.Bg4Brush" Color="{StaticResource Kraken.Bg4}" />
    <SolidColorBrush x:Key="Kraken.BorderBrush" Color="{StaticResource Kraken.Border}" />
    <SolidColorBrush x:Key="Kraken.BorderStrongBrush" Color="{StaticResource Kraken.BorderStrong}" />

    <SolidColorBrush x:Key="Kraken.VioletBrush" Color="{StaticResource Kraken.Violet}" />
    <SolidColorBrush x:Key="Kraken.VioletLightBrush" Color="{StaticResource Kraken.VioletLight}" />
    <SolidColorBrush x:Key="Kraken.VioletDarkBrush" Color="{StaticResource Kraken.VioletDark}" />
    <SolidColorBrush x:Key="Kraken.MagentaBrush" Color="{StaticResource Kraken.Magenta}" />
    <SolidColorBrush x:Key="Kraken.PinkBrush" Color="{StaticResource Kraken.Pink}" />
    <SolidColorBrush x:Key="Kraken.CyanBrush" Color="{StaticResource Kraken.Cyan}" />
    <SolidColorBrush x:Key="Kraken.GreenBrush" Color="{StaticResource Kraken.Green}" />
    <SolidColorBrush x:Key="Kraken.AmberBrush" Color="{StaticResource Kraken.Amber}" />
    <SolidColorBrush x:Key="Kraken.RedBrush" Color="{StaticResource Kraken.Red}" />

    <SolidColorBrush x:Key="Kraken.TextBrush" Color="{StaticResource Kraken.Text}" />
    <SolidColorBrush x:Key="Kraken.TextSecondaryBrush" Color="{StaticResource Kraken.TextSecondary}" />
    <SolidColorBrush x:Key="Kraken.TextMutedBrush" Color="{StaticResource Kraken.TextMuted}" />

    <SolidColorBrush x:Key="Kraken.VioletBrush10" Color="#1A8B5CF6" />
    <SolidColorBrush x:Key="Kraken.VioletBrush20" Color="#338B5CF6" />
    <SolidColorBrush x:Key="Kraken.VioletBrush40" Color="#668B5CF6" />
    <SolidColorBrush x:Key="Kraken.WhiteBrush05" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Kraken.WhiteBrush10" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Kraken.Glass" Color="#B3140F22" />
    <SolidColorBrush x:Key="Kraken.GlassStrong" Color="#E6120D1F" />

    <LinearGradientBrush x:Key="Kraken.AccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="{StaticResource Kraken.VioletDark}" />
        <GradientStop Offset="0.55" Color="{StaticResource Kraken.Violet}" />
        <GradientStop Offset="1" Color="{StaticResource Kraken.Magenta}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Kraken.SeedGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#0E9F8A" />
        <GradientStop Offset="1" Color="{StaticResource Kraken.Cyan}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Kraken.TextGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="{StaticResource Kraken.VioletLight}" />
        <GradientStop Offset="1" Color="{StaticResource Kraken.Magenta}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Kraken.CardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#1A1430" />
        <GradientStop Offset="1" Color="#140F22" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Kraken.WindowGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#0E0A19" />
        <GradientStop Offset="1" Color="#0A0712" />
    </LinearGradientBrush>

    <!-- Kraken logo geometry: a stylised octopus head with four tentacles -->
    <StreamGeometry x:Key="Kraken.LogoGeometry">M12 2C7.58 2 4 5.36 4 9.5c0 2.03.85 3.87 2.24 5.21-.5.86-1.31 1.5-2.24 1.79-.65.2-.6 1.16.08 1.27 1.4.22 2.83-.26 3.84-1.27.72.37 1.5.62 2.32.75-.16.9-.72 1.66-1.53 2.06-.6.29-.36 1.2.31 1.19 1.63-.03 3.05-1.05 3.62-2.52.18.01.36.02.54.02.11 0 .22 0 .33-.01.57 1.47 1.98 2.48 3.6 2.51.67.01.91-.9.31-1.19-.81-.4-1.36-1.15-1.52-2.05.82-.14 1.6-.4 2.32-.77 1.01 1.02 2.44 1.5 3.84 1.28.68-.11.73-1.07.08-1.27-.93-.29-1.74-.93-2.24-1.79A7.02 7.02 0 0 0 20 9.5C20 5.36 16.42 2 12 2zm-3 6.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm6 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z</StreamGeometry>

