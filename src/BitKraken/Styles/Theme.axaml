<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://BitKraken/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Typography ===== -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, Segoe UI, Helvetica Neue, sans-serif" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Code, JetBrains Mono, SF Mono, Menlo, Consolas, monospace" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="TextBlock.gradient">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextGradient}" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg4Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg2Brush}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Accent (primary) button with glow -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource Kraken.AccentGradient}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.AccentGradient}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletDarkBrush}" />
    </Style>

    <!-- Ghost / icon buttons -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.WhiteBrush10}" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33F87171" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.RedBrush}" />
    </Style>

    <!-- Window chrome buttons -->
    <Style Selector="Button.chrome">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextMutedBrush}" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.WhiteBrush10}" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Sidebar navigation buttons -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextSecondaryBrush}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid ColumnDefinitions="3,*">
                        <Border Name="PART_Pill" Grid.Column="0" Width="3" Height="16" CornerRadius="2"
                                Background="{StaticResource Kraken.VioletBrush}" Opacity="0" Margin="-12,0,0,0" HorizontalAlignment="Left">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Margin="0" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{StaticResource Kraken.WhiteBrush05}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#PART_Root">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush20}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#PART_Pill">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ===== Text inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg1Brush}" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CaretBrush" Value="{StaticResource Kraken.VioletLightBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Kraken.VioletBrush40}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderStrongBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.VioletBrush}" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderBrush}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderBrush}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{StaticResource Kraken.AccentGradient}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletLightBrush}" />
    </Style>
    <Style Selector="ToggleSwitch:unchecked /template/ Border#OuterBorder">
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderStrongBrush}" />
        <Setter Property="Background" Value="{StaticResource Kraken.Bg1Brush}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.VioletBrush}" />
    </Style>
    <Style Selector="CheckBox:unchecked /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderStrongBrush}" />
        <Setter Property="Background" Value="{StaticResource Kraken.Bg1Brush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush20}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush40}" />
    </Style>

    <!-- ===== Lists ===== -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.torrents > ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.torrents > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="ListBox.torrents > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.torrents > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.torrents > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Torrent card -->
    <Style Selector="Border.cardShadow">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.cardShadow">
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.cardShadow">
        <Setter Property="BoxShadow" Value="0 0 0 1 #668B5CF6, 0 10 30 0 #40000000, 0 0 40 0 #268B5CF6" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Kraken.CardGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.card">
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderStrongBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.card">
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.VioletBrush}" />
    </Style>

    <!-- Detail table rows -->
    <Style Selector="ListBox.table > ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ListBox.table > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.WhiteBrush05}" />
    </Style>
    <Style Selector="ListBox.table > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush20}" />
    </Style>

    <!-- Pills -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Background" Value="{StaticResource Kraken.WhiteBrush10}" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== Tabs (pill style) ===== -->
    <Style Selector="TabControl.pills">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.pills /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TabControl.pills TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextMutedBrush}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root" Background="Transparent" CornerRadius="99" Padding="{TemplateBinding Padding}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.pills TabItem:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{StaticResource Kraken.WhiteBrush05}" />
    </Style>
    <Style Selector="TabControl.pills TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
    </Style>
    <Style Selector="TabControl.pills TabItem:selected /template/ Border#PART_Root">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush20}" />
    </Style>

    <!-- ===== Scrollbars: slim & subtle ===== -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg4Brush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush}" />
    </Style>

    <!-- ===== Misc ===== -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{StaticResource Kraken.BorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource Kraken.Bg3Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource Kraken.GlassStrong}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kraken.BorderStrongBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Kraken.TextBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush20}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource Kraken.VioletBrush20}" />
    </Style>
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <!-- Fade in animation for new cards -->
    <Style Selector="Panel.fadein">
        <Style.Animations>
            <Animation Duration="0:0:0.45" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Pulsing live indicator -->
    <Style Selector="Ellipse.pulse">
        <Style.Animations>
            <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
