             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BitKraken.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://BitKraken/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
